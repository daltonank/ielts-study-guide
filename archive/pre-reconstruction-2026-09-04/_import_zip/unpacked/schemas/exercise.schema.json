{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Exercise",
  "type": "object",
  "required": [
    "id",
    "type",
    "skill",
    "questionFamily",
    "difficulty",
    "prompt",
    "estimatedMinutes",
    "originality"
  ],
  "properties": {
    "id": {
      "type": "string"
    },
    "type": {
      "type": "string"
    },
    "skill": {
      "type": "string"
    },
    "questionFamily": {
      "type": "string"
    },
    "difficulty": {
      "enum": [
        "foundation",
        "6.5",
        "7",
        "7.5",
        "8"
      ]
    },
    "prompt": {
      "type": "string",
      "minLength": 1
    },
    "options": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "correctAnswer": {},
    "explanation": {
      "type": "string"
    },
    "distractorReasoning": {
      "type": "object"
    },
    "errorCategory": {
      "type": "string"
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "estimatedMinutes": {
      "type": "number",
      "minimum": 0
    },
    "originality": {
      "enum": [
        "original",
        "official-link",
        "licensed"
      ]
    }
  }
}